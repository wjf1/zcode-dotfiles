{{- /* ZCode dotfiles 的 chezmoi 配置模板：首次 init 交互采集，promptStringOnce 每台机器只问一次 */ -}}
{{- $defaultPython := "/usr/bin/python3" -}}
{{- if eq .chezmoi.os "windows" -}}
{{-   $defaultPython = joinPath .chezmoi.homeDir "AppData" "Local" "Programs" "Python" "Python312" "python.exe" -}}
{{- end -}}
{{- $python := promptStringOnce . "zcodePythonPath" "Python 3 解释器绝对路径（token 用量状态栏 MCP 用；直接回车采用默认值）" $defaultPython -}}
{{- $defaultMemory := "" -}}
{{- if eq .chezmoi.os "windows" -}}
{{-   $defaultMemory = joinPath .chezmoi.homeDir "AppData" "Local" "Programs" "codebase-memory-mcp" "codebase-memory-mcp.exe" -}}
{{- end -}}
{{- $memory := promptStringOnce . "zcodeCodebaseMemoryPath" "codebase-memory-mcp.exe 绝对路径（仅 Windows；未安装直接回车留空即不渲染该 MCP）" $defaultMemory -}}

[data]
    zcodePythonPath = {{ $python | quote }}
    zcodeCodebaseMemoryPath = {{ $memory | quote }}

# [interpreters.py] 保留为将来可能的 .py 部署脚本兜底：v2.4.0 起 config.json 合并已改由
# chezmoi:modify-template 实现（dot_zcode/cli/modify_config.json，无 .tmpl 后缀），
# 仓库当前已无 .py 部署脚本，此配置无害（macOS/Linux 走 shebang）。
# Python 解释器路径本身仍是 token 用量状态栏 MCP 的必需项（config.json 的 statusbar 条目指向它）。
[interpreters.py]
    command = {{ $python | quote }}
